# ==============================================================================
# FairDraw Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local to configure your custom environment.
# Note: If all values below are left empty, FairDraw automatically boots in
# Zero-Config Local Mock Mode (using localStorage and HTML5 BroadcastChannel API).
# ==============================================================================

# --- Optional: Firebase Cloud Realtime Sync ---
# Required ONLY if you wish to run multi-device live sync across remote smartphones.
# 1. Create a project at https://console.firebase.google.com
# 2. Enable "Anonymous Authentication" under Auth -> Sign-in method.
# 3. Create a Cloud Firestore database in Native mode.
# 4. Deploy the included security rules: firebase deploy --only firestore:rules
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# --- Optional: Cookieless Google Analytics 4 ---
# Set to your GA4 Measurement ID (e.g., G-XXXXXXXXXX) to enable cookieless telemetry.
# Leave empty to completely disable all analytics.
VITE_GA_MEASUREMENT_ID=

# --- Optional: Google AdSense Unit ---
# Set to your AdSense Publisher ID and Display Slot ID if self-hosting with monetization.
# Leave empty to display the built-in Open-Source Community Card.
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_SLOT_ID=
